# PTE V1 environment inventory
# Copy to an ignored local env file only when the relevant value is needed.
# Never commit real values. Deferred/operator entries should normally remain blank.
# Canonical classifications and provider constraints: docs/STACK.md

# -----------------------------------------------------------------------------
# APP PUBLIC — REQUIRED NOW
# -----------------------------------------------------------------------------
# Supabase project API keys:
# https://supabase.com/dashboard/project/<PROJECT_REF>/settings/api-keys
# Guidance:
# https://supabase.com/docs/guides/getting-started/api-keys
# Browser-visible by design; backend authorization/RLS remains mandatory.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# APP SERVER — DEFERRED
# -----------------------------------------------------------------------------
# Keep blank until the owning feature is separately authorized.
# Never rename any of these with NEXT_PUBLIC_*.
#
# Supabase privileged server key:
# https://supabase.com/dashboard/project/<PROJECT_REF>/settings/api-keys
SUPABASE_SECRET_KEY=
#
# Cloudinary server credential (cloud name + API key + API secret):
# https://console.cloudinary.com/settings/api-keys
# https://cloudinary.com/documentation/developer_onboarding_faq_find_credentials
CLOUDINARY_URL=
#
# YouTube Data API v3 public metadata/search quota credential:
# https://console.cloud.google.com/apis/credentials
# https://developers.google.com/youtube/v3/getting-started
# YouTube IFrame/embed playback itself is NO_KEY:
# https://developers.google.com/youtube/iframe_api_reference
YOUTUBE_API_KEY=

# -----------------------------------------------------------------------------
# OPERATOR-ONLY / HEADLESS
# -----------------------------------------------------------------------------
# Keep blank unless an operator/headless workflow actually requires the value.
# These are not learner application runtime dependencies.
#
# Supabase project/operator tooling:
SUPABASE_PROJECT_REF=
# Prefer connected OAuth/plugin auth when available; scoped PATs live here only
# for workflows that actually require a PAT:
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Only for direct database workflows that actually require DB authentication.
SUPABASE_DB_PASSWORD=
#
# Vercel headless/operator automation only. Git auto-deploy remains unactivated.
# Tokens:
# https://vercel.com/account/settings/tokens
# CLI token/project variables:
# https://vercel.com/docs/cli/global-options
# Project linking / orgId / projectId:
# https://vercel.com/docs/cli/project-linking
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Intentionally NOT present:
# OPENAI_API_KEY, HF_TOKEN, Google OAuth client credentials, Redis credentials,
# vector/embedding provider keys, analytics keys.
