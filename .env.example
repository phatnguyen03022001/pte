# Local setup
# 1. Copy this file to .env.local.
# 2. Fill the two public Supabase values below.
# 3. Never commit .env.local or any real secret-bearing env file.
#
# Official Supabase Next.js quickstart:
# https://supabase.com/docs/guides/getting-started/quickstarts/nextjs
#
# Official API key guide:
# https://supabase.com/docs/guides/getting-started/api-keys
#
# Project API keys:
# https://supabase.com/dashboard/project/<PROJECT_REF>/settings/api-keys
#
# Use the Project URL and a publishable key (sb_publishable_...).
# Do NOT put a secret key, service-role key, password, token, or private credential
# into a NEXT_PUBLIC_* variable.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
