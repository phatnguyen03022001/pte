# Public Supabase project configuration used by the application.
# These values identify the project and are safe for browser use; authorization
# must remain enforced by server-side checks and database row-level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase server/operator settings (never expose via NEXT_PUBLIC_*).
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Cloudinary server/operator credentials.
CLOUDINARY_URL=

# Vercel operator settings. Deployment remains disabled until explicitly authorized.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Optional Brevo SMTP reference for Supabase Auth email delivery.
# Configure these in Supabase Dashboard > Authentication > SMTP Settings.
# The Next.js app does NOT read these variables; never commit real credentials.
# Use a Brevo SMTP key (not a Brevo API key) as the SMTP password.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
